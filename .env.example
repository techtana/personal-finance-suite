FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change_me_in_production
FINANCE_DB_PATH=instance/finance.db

# Local model for AI features (the importer today). Older IMPORT_LLM_* names still work. Defaults reuse the personal agent stack's Ollama and its loaded model.
# LLM_PROVIDER=ollama              # ollama | openai | off (rules only; photos can't be read)
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3.5:9b
# LLM_VISION_MODEL=                # empty = same model (qwen3.5 reads photos)
# LLM_NUM_CTX=32768                # keep equal to the stack's num_ctx so Ollama doesn't reload the model
# LLM_TIMEOUT=180
# LLM_THINK=0
# Through the stack's LiteLLM gateway instead (traces show in the tray's Usage tab; no photos, the gateway
# marks the model supports_vision: false):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:4000/v1
# LLM_MODEL=local-small
# LLM_API_KEY=<LITELLM_MASTER_KEY from the agent stack's .env>
# LLM_ALLOW_REMOTE=0               # documents never leave this computer unless set to 1
# More places AI work can run (see docs/design/cloud-server-and-ai-endpoints.md)
# AI_HOME_RUNNER=1                 # on a server: let a home computer running home_runner.py collect AI work
# AI_RUNNER_TOKEN=                 # optional shared secret the runner must send
# AI_ENDPOINTS=[{"name":"finance-ai","kind":"own-cloud","provider":"ollama","base_url":"https://<service>.run.app","model":"qwen3.5:9b","auth":"google-id-token","use_for":["batch"],"assume_up":true}]
# Behind Tailscale Serve only (the deploy sets these):
# TRUST_TAILSCALE_HEADERS=1        # believe the Tailscale-User-Login header; never set this on an app others can reach directly
# ALLOWED_LOGINS=you@example.com   # optional second lock: who may use the app
# BACKUP_PRUNE=bucket              # the app only adds backups; a bucket rule removes old ones
# IMPORT_STORAGE_DIR=instance/imports     # copies of dropped files, for review and re-reading
# Cloud backups (Settings → Backups can override these).
# Sign in once with: gcloud auth application-default login
# or set GOOGLE_APPLICATION_CREDENTIALS to a service-account key file.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_BACKUP_BUCKET=
GCS_BACKUP_PREFIX=finance-backups/
